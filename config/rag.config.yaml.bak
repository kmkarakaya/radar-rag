server:
  port: 3010
registry:
  path: data/registry.sqlite
chroma:
  url: http://localhost:8000
ollama:
  baseUrl: http://localhost:11434
  chatModel: gemma3:4b-cloud
  embeddingModel: bge-m3
  numCtx: 4096
  numPredict: 128
collectionDefaults:
  sourcePath: data
  ozelgeDataPath: data/ozelge_veri.json
  distanceMetric: l2
  indexSampleSize: 0
  chunkSize: 500
  chunkOverlap: 200
  retrievalK: 5
  retrievalDistanceThreshold: 1
  timeoutMs: 90000
readiness:
  timeoutMs: 30000
  embeddingProbeText: readiness probe
  chatProbeText: hazirlik kontrolu
cleanup:
  retentionMs: 3600000
limits:
  maxConcurrentEmbeddings: 5
  maxConcurrentGenerations: 2
rateLimit:
  enabled: true
  windowMs: 60000
  maxRequestsPerWindow: 60
observability:
  includeDebugTimings: false
