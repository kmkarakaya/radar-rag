{
  "name": "vanilla-rag-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "onboard": "tsx src/admin/onboard.ts",
    "admin:hash-password": "tsx src/admin/passwordHash.ts",
    "index": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts test/acceptance/*.test.ts",
    "start": "node dist/server.js",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.34",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/ollama": "^1.0.0",
    "@langchain/openai": "^1.8.2",
    "@langchain/textsplitters": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "chromadb": "^3.5.0",
    "express": "^5.0.0",
    "langchain": "^1.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
